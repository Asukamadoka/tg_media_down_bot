# Copy to .env and fill in. Every value here overrides the same key in config.yaml.

# --- Telegram (required) ---------------------------------------------------
# From https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
# From @BotFather
TG_BOT_TOKEN=

# User session string. Generate once with:  python -m tgmd.login
# A user account is required: bots cannot read history of arbitrary chats.
TG_USER_SESSION=

# --- Access control -------------------------------------------------------
# Optional. Leave blank and the bot prints a claim code to its log; sending
# /claim <code> in Telegram makes you the admin with no restart or redeploy.
# Set it only to skip that step. Comma separated numeric Telegram user ids.
ADMIN_USER_IDS=
# Extra non-admin users allowed to use the bot.
ALLOWED_USER_IDS=
# Set to true only if you really want the bot open to everyone. The bot reads
# your private chats through your user session, so this is rarely what you want.
ALLOW_ALL_USERS=false

# --- Behaviour ------------------------------------------------------------
# telegram | local | pikpak
DEFAULT_MODE=telegram
CONCURRENT_DOWNLOADS=2
# Connections per file above 10 MB. Parallel parts are the only way to speed
# up content that cannot be forwarded. At most 8; 1 turns it off. Every
# connection is the reading account's own, so more is not always better.
DOWNLOAD_CONNECTIONS=4
# Download from Telegram's media-only endpoints where they are reachable
# directly (auto), instead of only the ones Telethon picks (off). On the NAS
# this lets DC4 files bypass the proxy; see deploy/restricted-network.
TG_DIRECT_MEDIA=off

# Where kept files go: local mode, auto mode's restricted files, and files too
# large to upload. Defaults to DOWNLOAD_DIR. Point it at a NAS share to watch
# them there; the container user (uid 10001) must be able to write to it.
# MEDIA_DIR=/media
# MEDIA_TEMPLATE={chat}/{name}
# Shown in front of a kept file's path, so the reply can be pasted as is.
# LOCAL_URL_PREFIX=smb://10.10.10.2/media/
DOWNLOAD_DIR=downloads
DATA_DIR=data
LOG_LEVEL=INFO

# Optional channel the bot administrates, used to cache uploads so a link
# requested twice is not downloaded twice. You do not need to find its id:
# add the bot to the channel as admin and post /cache there instead.
CACHE_CHAT_ID=

# --- PikPak (optional) ----------------------------------------------------
# A shared account, used by anyone who has not connected their own.
# Both of these can be left empty: users can connect their own account with
# /pikpak login (a Mini App, which needs the HTTPS server below) or with
# /setup pikpak in a private chat (which needs nothing).
PIKPAK_USERNAME=
PIKPAK_PASSWORD=
PIKPAK_FOLDER=/TelegramMedia

# Let users connect their own PikPak account. Only the resulting token is
# stored, never the password.
PIKPAK_ALLOW_USER_LOGIN=true

# Let PikPak read Telegram media straight from Telegram through the HTTP
# server, with nothing written to this machine's disk. Off until measured.
PIKPAK_STREAM=false

# --- PikPak warehouse (pikpak_wms, docs/wms/) ------------------------------
# Run the warehouse's scheduled jobs (stocktake, organize by rules, cleanup)
# inside the bot, on the PikPak account the bot already has. Off by default.
# Its settings live in /data/db/wms.yaml and /data/db/rules.yaml (copy them
# from config/*.example.yaml); without a wms.yaml nothing is scheduled.
WMS_ENABLED=false
# Whose drive it manages: a Telegram user id, or "shared" for the shared
# account above. Empty: the first admin who connected their own PikPak
# account, else the shared account.
WMS_ACCOUNT=
# After files land in PikPak (magnet, URL, share link, Telegram media in
# pikpak mode), run the organize rules on them: "plan" sends the plan with a
# confirm button, "apply" shelves at once, "off" leaves them be. Rules only see
# folders in their scope, so point PIKPAK_FOLDER inside one (e.g. /Inbox).
WMS_AUTO_SHELVE=plan
# Natural-language commands (/do, or plain text from admins in private).
# The built-in parser always goes first. For sentences it does not understand:
#   NL_BACKEND=claude  -> the Anthropic API (set ANTHROPIC_API_KEY)
#   NL_BACKEND=ollama  -> a local Ollama (set OLLAMA_URL)
# Only the sentence, the answer's schema and the current date leave the NAS.
NL_BACKEND=rules
NL_FALLBACK=none
# ANTHROPIC_API_KEY=
# NL_CLAUDE_MODEL=claude-opus-5
# OLLAMA_URL=http://ollama:11434
# NL_OLLAMA_MODEL=qwen2.5:3b
# Only for `wms outbound --downloader aria2`: aria2's RPC secret.
# ARIA2_SECRET=

# --- HTTP file server (required only for Telegram -> PikPak transfers) -----
# PikPak pulls files by URL, so the bot must expose the downloaded file at a
# publicly reachable address. Leave disabled if you only save locally or send
# files back through Telegram.
HTTP_ENABLED=false
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# Public address of the HTTP server above, e.g. https://media.example.com
PUBLIC_BASE_URL=

# --- Language -------------------------------------------------------------
# Which message catalogue the bot replies in: en or zh. This changes only what
# people read: command names, their arguments (/mode local), stored job states
# and the deployment log all stay English. POSIX LANG is deliberately ignored,
# because images set it to C.UTF-8 for unrelated reasons.
TGMD_LANG=en
