# Copy to .env and fill in. Every value here overrides the same key in config.yaml.

# --- Telegram (required) ---------------------------------------------------
# From https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
# From @BotFather
TG_BOT_TOKEN=

# User session string. Generate once with:  python -m tgmd.login
# A user account is required: bots cannot read history of arbitrary chats.
TG_USER_SESSION=

# --- Access control -------------------------------------------------------
# Comma separated numeric Telegram user ids. Admins can always use the bot.
ADMIN_USER_IDS=
# Extra non-admin users allowed to use the bot.
ALLOWED_USER_IDS=
# Set to true only if you really want the bot open to everyone. The bot reads
# your private chats through your user session, so this is rarely what you want.
ALLOW_ALL_USERS=false

# --- Behaviour ------------------------------------------------------------
# telegram | local | pikpak
DEFAULT_MODE=telegram
CONCURRENT_DOWNLOADS=2
DOWNLOAD_DIR=downloads
DATA_DIR=data
LOG_LEVEL=INFO

# Optional channel/group the bot is admin of, used to cache uploads so that a
# link requested twice is not downloaded twice.
CACHE_CHAT_ID=

# --- PikPak (optional) ----------------------------------------------------
PIKPAK_USERNAME=
PIKPAK_PASSWORD=
PIKPAK_FOLDER=/TelegramMedia

# --- HTTP file server (required only for Telegram -> PikPak transfers) -----
# PikPak pulls files by URL, so the bot must expose the downloaded file at a
# publicly reachable address. Leave disabled if you only save locally or send
# files back through Telegram.
HTTP_ENABLED=false
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# Public address of the HTTP server above, e.g. https://media.example.com
PUBLIC_BASE_URL=
