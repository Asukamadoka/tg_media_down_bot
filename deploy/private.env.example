# Every variable that identifies THIS deployment, with placeholders only (docs/security/README.md).
#
# This file is a checklist, not a config. The real values live in a private store outside this
# repository: the NAS's own `.env` (the runtime source of truth, next to the compose file) and a
# private copy of it that Saki owns. Never put a real value here, in a commit message, in an
# issue or in a pull request. The `*` after `private.env` is ignored by git and Docker except
# this example (.gitignore, .dockerignore).
#
#   cp deploy/private.env.example deploy/private.env     # gitignored; fill in, then keep it private
#
# Credentials (TG_API_ID, TG_API_HASH, TG_BOT_TOKEN, TG_USER_SESSION, PIKPAK_PASSWORD,
# ANTHROPIC_API_KEY, NL_OPENAI_API_KEY, ARIA2_SECRET) are not listed: they go in the NAS's `.env`
# or the macOS Keychain only, and never in a file that is copied around.

# --- Who ------------------------------------------------------------------
# The owner's Telegram user id(s), comma separated. Real value: the NAS's .env, or leave empty
# and claim with /claim.
ADMIN_USER_IDS=
# Extra allowed user ids. Real value: the NAS's .env.
ALLOWED_USER_IDS=
# Telegram user id the warehouse manages, or "shared". Real value: the NAS's .env.
WMS_ACCOUNT=
# The shared PikPak account's login name. Real value: the NAS's .env (the password never leaves it).
PIKPAK_USERNAME=

# --- Chats ----------------------------------------------------------------
# The cache channel's id, e.g. -1001234567890. Real value: the bot's database (/cache) and the
# NAS's .env.
CACHE_CHAT_ID=-1001234567890

# --- Addresses ------------------------------------------------------------
# The LAN machine(s) serving the models, <MODEL_HOST> or <MODEL_HOST>:11434. Real value: the
# NAS's .env.
TRAFFIC_MODEL_HOST=
# Model endpoints, comma separated, best first, e.g. http://<MODEL_HOST>:11434/v1. Real value:
# the NAS's .env.
NL_OPENAI_BASE_URL=
# What to call each host in plans, in the same order. Real value: the NAS's .env.
NL_OPENAI_NAMES=
# A local or LAN Ollama, e.g. http://<MODEL_HOST>:11434. Real value: the NAS's .env.
OLLAMA_URL=
# The bot's public HTTPS address, e.g. https://<FUNNEL_HOST>. Real value: the NAS's .env and
# Saki's private notes.
PUBLIC_BASE_URL=
# mihomo's controller, if it is not the default. Real value: the NAS's .env.
MIHOMO_API=
# Hosts to speed-test for a direct route (host=url pairs), if they identify the deployment.
DIRECT_TEST_URLS=

# --- Paths and shares -------------------------------------------------------
# Shown in front of a kept file's path, e.g. smb://<NAS_IP>/<SHARE>/. Real value: the NAS's .env.
LOCAL_URL_PREFIX=smb://<NAS_IP>/<SHARE>/
# The library as the container sees it (compose mounts the host path below there). Real value:
# the NAS's .env; /library is the usual in-container path.
LIBRARY_DIR=/library
# Host paths for the compose volumes (deploy/restricted-network/docker-compose.yml reads these
# with ${VAR}). Real value: the NAS's .env next to its compose file, e.g. /volumeN/<share>.
LIBRARY_HOST_DIR=<NAS_VOLUME>/<LIBRARY_SHARE>
MEDIA_HOST_DIR=<NAS_VOLUME>/<MEDIA_SHARE>
